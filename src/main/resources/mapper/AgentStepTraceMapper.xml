<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kama.jchatmind.mapper.AgentStepTraceMapper">

    <resultMap id="BaseResultMap" type="com.kama.jchatmind.model.entity.AgentStepTrace">
        <id     property="id"               column="id"                jdbcType="VARCHAR"/>
        <result property="traceId"          column="trace_id"          jdbcType="VARCHAR"/>
        <result property="stepIndex"        column="step_index"        jdbcType="INTEGER"/>
        <result property="phase"            column="phase"             jdbcType="VARCHAR"/>
        <result property="modelName"        column="model_name"        jdbcType="VARCHAR"/>
        <result property="promptTokens"     column="prompt_tokens"     jdbcType="INTEGER"/>
        <result property="completionTokens" column="completion_tokens" jdbcType="INTEGER"/>
        <result property="latencyMs"        column="latency_ms"        jdbcType="BIGINT"/>
        <result property="status"           column="status"            jdbcType="VARCHAR"/>
        <result property="errorMessage"     column="error_message"     jdbcType="VARCHAR"/>
        <result property="startedAt"        column="started_at"        jdbcType="TIMESTAMP"/>
        <result property="finishedAt"       column="finished_at"       jdbcType="TIMESTAMP"/>
        <result property="createdAt"        column="created_at"        jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, trace_id, step_index, phase, model_name,
        prompt_tokens, completion_tokens, latency_ms,
        status, error_message, started_at, finished_at, created_at
    </sql>

    <insert id="insert" parameterType="com.kama.jchatmind.model.entity.AgentStepTrace"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO agent_step_trace
            (trace_id, step_index, phase, model_name, status, started_at)
        VALUES
            (CAST(#{traceId} AS uuid),
             #{stepIndex},
             #{phase},
             #{modelName},
             #{status},
             #{startedAt})
    </insert>

    <select id="selectByTraceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM agent_step_trace
        WHERE trace_id = CAST(#{traceId} AS uuid)
        ORDER BY step_index ASC, started_at ASC
    </select>

    <update id="updateById" parameterType="com.kama.jchatmind.model.entity.AgentStepTrace">
        UPDATE agent_step_trace
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="promptTokens != null">prompt_tokens = #{promptTokens},</if>
            <if test="completionTokens != null">completion_tokens = #{completionTokens},</if>
            <if test="latencyMs != null">latency_ms = #{latencyMs},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
            <if test="finishedAt != null">finished_at = #{finishedAt},</if>
        </set>
        WHERE id = CAST(#{id} AS uuid)
    </update>

</mapper>
